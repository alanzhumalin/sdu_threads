APP_ENV=development
APP_PORT=8080

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sdu_db
POSTGRES_PORT=55432
DATABASE_URL=postgres://sdu_user:sdu_pass@db:5432/sdu_db?sslmode=disable

JWT_SECRET=
JWT_TTL_HOURS=24
RATE_LIMIT_RPM=120

# Admin bootstrap user (created on backend start if not exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_FULL_NAME=

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=
S3_SIGNATURE_VERSION=v2

MODERATION_ENABLED=false
MODERATION_URL=
MODERATION_TIMEOUT_MS=4000
MODERATION_FAIL_CLOSED=false
MODERATION_TEXT_THRESHOLD=0.75
MODERATION_TEXT_MODEL=s-nlp/russian_toxicity_classifier
MODERATION_TEXT_MODEL_REQUIRED=false
MODERATION_BLOCKED_TERMS=



CACHE_ENABLED=true
CACHE_REDIS_ADDR=redis:6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0
CACHE_KEY_PREFIX=sdu:cache:
CACHE_L1_MAX_ENTRIES=5000
CACHE_L1_CLEANUP_SEC=60

TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_MIN=10
TELEGRAM_BOT_POLL_TIMEOUT_SEC=45
TELEGRAM_NOTIFY_PREVIEW_RUNES=180
# One URL or multiple URLs separated by comma, e.g.
# APP_PUBLIC_URL=https://sduthreads.com,https://sduthreads.online
APP_PUBLIC_URL=
