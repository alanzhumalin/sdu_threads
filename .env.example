APP_ENV=development
APP_PORT=8080

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sdu_db
POSTGRES_PORT=55432
DATABASE_URL=postgres://sdu_user:sdu_pass@db:5432/sdu_db?sslmode=disable

JWT_SECRET=
JWT_TTL_HOURS=24
RATE_LIMIT_RPM=120

# Admin bootstrap user (created on backend start if not exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_FULL_NAME=

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=
S3_SIGNATURE_VERSION=v2

MODERATION_ENABLED=true
MODERATION_URL=http://moderation:8001
MODERATION_TIMEOUT_MS=4000
MODERATION_FAIL_CLOSED=true
MODERATION_TEXT_THRESHOLD=0.75
MODERATION_IMAGE_THRESHOLD=0.70
MODERATION_SUGGESTIVE_THRESHOLD=0.45
MODERATION_BLOCK_SUGGESTIVE=true
MODERATION_TEXT_MODEL=s-nlp/russian_toxicity_classifier
MODERATION_IMAGE_MODEL=Falconsai/nsfw_image_detection
MODERATION_SUGGESTIVE_MODEL=prithivMLmods/Mature-Content-Detection
MODERATION_TEXT_MODEL_REQUIRED=false
MODERATION_IMAGE_MODEL_REQUIRED=true
MODERATION_SUGGESTIVE_MODEL_REQUIRED=false
MODERATION_INFER_MAX_SIDE=1024
MODERATION_PRELOAD_MODELS=true
MODERATION_BLOCKED_TERMS=



CACHE_ENABLED=true
CACHE_REDIS_ADDR=redis:6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0
CACHE_KEY_PREFIX=sdu:cache:
CACHE_L1_MAX_ENTRIES=5000
CACHE_L1_CLEANUP_SEC=60
